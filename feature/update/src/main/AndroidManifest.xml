<?xml version="1.0" encoding="utf-8"?>
<!-- Merged only into the sideload flavour. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the updater download automatically only on unmetered (Wi-Fi) networks. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets CloakRun install its own verified updates. Android asks the user to allow it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <receiver
            android:name=".InstallStatusReceiver"
            android:exported="false" />
    </application>
</manifest>
