<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CloakRun" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Pre-Android 12: the compat splash shows the static emblem. -->
    <style name="Theme.CloakRun.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_static</item>
        <item name="postSplashScreenTheme">@style/Theme.CloakRun</item>
    </style>
</resources>
