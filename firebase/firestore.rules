rules_version = '2';

// CloakRun Firestore rules.
//
// Phase 0 baseline: everything is denied. The game data model and its rules land in
// Phase 3 together with emulator tests in firebase/tests. Deny-by-default means a
// freshly created project is never left open, even before the real rules ship.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
